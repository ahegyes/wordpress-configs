<?xml version="1.0"?>
<!-- Repo self-lint: lints this repo only, extending the shared php/quality-assurance/phpcs.dist.xml profile; tests/ is linted by phpcs.tests.dist.xml. -->
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<rule ref="./php/quality-assurance/phpcs.dist.xml">
		<!-- Composer runs this code, never WordPress, so it calls PHP's own file_get_contents() and var_export(). -->
		<exclude name="WordPress.WP"/>
		<exclude name="WordPress.PHP.DevelopmentFunctions"/>
		<!-- php-parser and phpdoc-parser expose camelCase properties. -->
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<!-- Output goes to the console and to exception messages, never to HTML. -->
		<exclude name="WordPress.Security"/>
	</rule>
</ruleset>
