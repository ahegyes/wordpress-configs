# Baseline wp dist-archive exclusions for WordPress projects.
# Copy this file to each consumer project root and extend it there.

.git
.github
.idea
.vscode
.editorconfig
.gitattributes
.gitignore
.distignore
node_modules
tests
vendor/bin
composer.json
composer.lock
package.json
package-lock.json
.phpcs.xml
phpcs.dist.xml
.phpstan.neon
phpstan.dist.neon
phpunit.xml*
infection.json*
eslint.config.*
stylelint.config.*
tsconfig.json
playwright.config.*
scoper.inc.php
scoping-exclusions.json
.wp-env*
.wordpress-org

# Secret material — never ship, even when a consumer forgets to list it.
# .pem/.key are root-anchored (leading /) so certs bundled under vendor/ (e.g. CA bundles) still ship.
.env*
/*.pem
/*.key
id_rsa*
.npmrc
auth.json
