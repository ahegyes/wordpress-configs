.phpcs.xml
phpcs.dist.xml
.phpstan.neon
phpstan.dist.neon
phpunit.xml*
infection.json*
eslint.config.*
stylelint.config.*
tsconfig.json
playwright.config.*
scoper.inc.php
scoping-exclusions.json
.wp-env*
.wordpress-org
