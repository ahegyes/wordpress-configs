# Baseline wp dist-archive exclusions for WordPress projects.
# Copy this file to each consumer project root and extend it there.

.git
.github
.idea
.vscode
.editorconfig
.gitattributes
.gitignore
.distignore
AGENTS.md
CLAUDE.md
/changelog
node_modules
tests
vendor/bin
composer.json
composer.lock
package.json
package-lock.json
.phpcs*.xml*
phpcs*.xml*
.phpstan*.neon*
phpstan*.neon*
phpunit*.xml*
.phpunit.result.cache
.phpunit.cache
infection.json*
eslint.config.*
stylelint.config.*
tsconfig.json
playwright.config.*
scoper.inc.php
.wp-env*
.wordpress-org

# Secret material — never ship, even when a consumer forgets to list it.
# .pem is root-anchored (leading /) so certs bundled under vendor/ (e.g. CA bundles) still ship.
.env*
/*.pem
*.key
id_rsa*
.npmrc
auth.json
