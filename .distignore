# Baseline wp dist-archive exclusions for WordPress projects.

.git
.github
.idea
.vscode
.editorconfig
.gitattributes
.gitignore
.distignore
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
SECURITY.md
/changelog
node_modules
tests
vendor/bin
composer.json
composer.lock
package.json
package-lock.json
.phpcs*.xml*
phpcs*.xml*
.phpstan*.neon*
phpstan*.neon*
phpunit*.xml*
.phpunit.result.cache
.phpunit.cache
infection.json*
eslint.config.*
stylelint.config.*
tsconfig.json
playwright.config.*
postcss.config.*
scoper.inc.php
.wp-env*
.wordpress-org

# Secret material, with .pem anchored to the root so certificates bundled under vendor/ still ship.
.env*
/*.pem
*.key
id_rsa*
.npmrc
auth.json
