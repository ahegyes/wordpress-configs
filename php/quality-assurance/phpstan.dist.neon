# Shared PHPStan baseline: every consumer repo's phpstan.neon extends this, so edits here reach all DWS repos.
includes:
    - phpstan.dist.neon.php

parameters:
    level: 8
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false
    strictRules:
        disallowedShortTernary: false
    excludePaths:
        analyseAndScan:
            - %currentWorkingDirectory%/vendor/*
            - %currentWorkingDirectory%/node_modules/*
            - %currentWorkingDirectory%/dependencies/*
