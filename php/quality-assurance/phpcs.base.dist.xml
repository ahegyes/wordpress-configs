<?xml version="1.0"?>
<!-- Shared PHPCS rules: phpcs.dist.xml and phpcs.tests.dist.xml both include this file, so edits here reach production and test code in every DWS repo. -->
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- What NOT to scan. -->
	<!-- PHPCS matches each pattern as a case-insensitive regex over the absolute path: (?-i) keeps source folders such as src/Vendor/ in the scan, and literal dots are escaped. -->
	<!-- No tests/ pattern here: an included ruleset's exclude-patterns apply to the ruleset that includes it, so the tests profile would scan nothing. -->
	<exclude-pattern>(?-i)*/bin/*</exclude-pattern>
	<exclude-pattern>(?-i)*/vendor/*</exclude-pattern>
	<exclude-pattern>(?-i)*/vendor-prefixed/*</exclude-pattern> <!-- Generated php-scoper output. -->
	<exclude-pattern>(?-i)*/node_modules/*</exclude-pattern>
	<exclude-pattern>(?-i)*/index\.php</exclude-pattern> <!-- Silence-is-golden stubs; this file is supposed to be empty. -->
	<exclude-pattern>(?-i)*/*\.asset\.php</exclude-pattern> <!-- This file is generated by the Gutenberg build process. -->
	<exclude-pattern>(?-i)*/blocks-manifest\.php</exclude-pattern> <!-- This file is generated by the @wordpress/scripts build-blocks-manifest step. -->
	<exclude-pattern>(?-i)*/languages/*\.l10n\.php</exclude-pattern> <!-- This file is generated by the internationalization process. -->

	<!-- How to scan. -->
	<arg value="sp"/> <!-- Show sniff and progress. -->
	<arg name="colors"/> <!-- Show results with colors. -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results. -->
	<arg name="extensions" value="php"/> <!-- Only scan PHP files. -->

	<!-- Applied rulesets. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.5-"/>

	<!-- Referenced before WordPress, which contains it: a rule's exclude-patterns reach only the sniffs it adds first. -->
	<rule ref="WordPress-Docs">
		<!-- Exclude Block Editor patterns since they require special headers. -->
		<exclude-pattern>(?-i)*/patterns/*</exclude-pattern>
	</rule>

	<!-- The full standard, so the database and input-sanitization sniffs Plugin Check runs also run here. -->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<!-- Ignore missing file comment. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<!-- Ignore end char rule since it conflicts with PhpStorm's code folding regions. -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar" />
	</rule>
	<config name="minimum_wp_version" value="7.1"/>

	<!-- Sub-rule property customisations. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<!-- Allow additional word delimiters for hook names. -->
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="Squiz.Commenting.FunctionComment">
		<!-- Ignore missing tags if @inheritDoc is present. -->
		<properties>
			<property name="skipIfInheritdoc" value="true" />
		</properties>
		<!-- Allow generic type syntax (class-string<X>, list<X>) in docblocks over the erased native hint (string, array). -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>

	<!-- Disabled rules. -->
	<rule ref="PSR12.Files.FileHeader.IncorrectOrder">
		<!-- Inline `<?php declare( strict_types=1 );` allowed even with file docblock. -->
		<severity>0</severity>
	</rule>

	<rule ref="Universal.Operators.DisallowShortTernary">
		<!-- Short ternary `?:` allowed workspace-wide. -->
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.Commenting.FunctionCommentThrowTag.WrongNumber">
		<!-- Squiz miscounts @throws against implicit throws (e.g. `JSON_THROW_ON_ERROR`). -->
		<severity>0</severity>
	</rule>
</ruleset>
