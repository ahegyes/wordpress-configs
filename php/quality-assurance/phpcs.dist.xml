<?xml version="1.0"?>
<!-- Shared PHPCS baseline: every consumer repo's phpcs.xml extends this, so edits here reach all DWS repos. -->
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- What NOT to scan. -->
	<exclude-pattern>*/bin/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dependencies/*</exclude-pattern> <!-- Generated php-scoper output (the scoping pipeline writes it). -->
	<exclude-pattern>*/*.asset.php</exclude-pattern> <!-- This file is generated by the Gutenberg build process. -->
	<exclude-pattern>*/languages/*.l10n.php</exclude-pattern> <!-- This file is generated by the internationalization process. -->

	<!-- How to scan. -->
	<arg value="sp"/> <!-- Show sniff and progress. -->
	<arg name="colors"/> <!-- Show results with colors. -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results. -->
	<arg name="extensions" value="php"/> <!-- Only scan PHP files. -->

	<!-- Applied rulesets. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.5-"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
	</rule>
	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress-Docs">
		<!-- Ignore missing file comment. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<!-- Ignore end char rule since it conflicts with PhpStorm's code folding regions. -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar" />
		<!-- Exclude Block Editor patterns since they require special headers. -->
		<exclude-pattern>*/patterns/*</exclude-pattern>
	</rule>

	<!-- Sub-rule property customisations. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<!-- Allow additional word delimiters for hook names. -->
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<!-- Disallow blank lines at start/end of for/foreach/if blocks. -->
		<properties>
			<property name="blank_line_check" value="true"/>
		</properties>
	</rule>

	<rule ref="Squiz.Commenting.FunctionComment">
		<!-- Ignore missing tags if @inheritDoc is present. -->
		<properties>
			<property name="skipIfInheritdoc" value="true" />
		</properties>
		<!-- Allow generic type syntax (class-string<X>, list<X>) in docblocks over the erased native hint (string, array). -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
		<!-- Test methods are not API surface — no docblocks required. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Test-only relaxations: tests are linted, but a few sniffs don't apply — test classes/methods/
	     properties carry no docblocks, fixtures legitimately override globals, and test helpers need no
	     global prefix. Scoped to tests/ only. -->
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<!-- Test doubles and recorders must match the signature they stand in for. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<!-- Fixture classes co-locate with the test that owns them. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<!-- Test and smoke-script exceptions surface in CLI output, not HTML. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidHookName.UseUnderscores">
		<!-- Tests fire deliberately malformed hook names at validators. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<!-- Tests run without WordPress; native filesystem functions are correct here. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<!-- Smoke fixtures trap warnings via set_error_handler and dump diagnostics on failure. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Disabled rules. -->
	<rule ref="PSR12.Files.FileHeader.IncorrectOrder">
		<!-- Inline `<?php declare( strict_types=1 );` allowed even with file docblock. -->
		<severity>0</severity>
	</rule>

	<rule ref="Universal.Operators.DisallowShortTernary">
		<!-- Short ternary `?:` allowed workspace-wide. -->
		<severity>0</severity>
	</rule>

	<rule ref="Squiz.Commenting.FunctionCommentThrowTag.WrongNumber">
		<!-- Squiz miscounts @throws against implicit throws (e.g. `JSON_THROW_ON_ERROR`). -->
		<severity>0</severity>
	</rule>
</ruleset>
