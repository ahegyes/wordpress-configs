{
  "name": "ahegyes/wordpress-configs",
  "type": "library",

  "description": "Shared PHPCS, PHPStan and php-scoper configurations and reusable GitHub Actions workflows for WordPress projects.",
  "license": "MIT",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/ahegyes/wordpress-configs/graphs/contributors"
    }
  ],

  "require": {
    "php": ">=8.5",
    "ext-json": "*",

    "composer/class-map-generator": "^1",
    "nikic/php-parser": "^5",
    "sniccowp/php-scoper-wordpress-excludes": "^7.1",
    "symfony/filesystem": "^7.4",
    "symfony/finder": "^7.4",

    "wp-coding-standards/wpcs": "^3.4.1",
    "phpcompatibility/phpcompatibility-wp": "^3@alpha",

    "phpstan/phpstan": "^2",
    "phpstan/extension-installer": "^1",
    "phpstan/phpstan-deprecation-rules": "^2",
    "phpstan/phpstan-strict-rules": "^2",
    "php-stubs/wordpress-stubs": "^7.1",
    "johnbillion/wp-compat": "^2",
    "szepeviktor/phpstan-wordpress": "^2",
    "swissspidy/phpstan-no-private": "^1",

    "roave/security-advisories": "dev-latest"
  },
  "require-dev": {
    "composer/composer": "^2",
    "dompdf/dompdf": "^3.1",
    "humbug/php-scoper": "^0.18",
    "infection/infection": "^0.35",
    "php-di/php-di": "^7",
    "php-stubs/woocommerce-stubs": "^11.1",
    "phpunit/phpunit": "^13",
    "psr/container": "^2",
    "psr/log": "^3",
    "symfony/yaml": "^8.1"
  },
  "suggest": {
    "humbug/php-scoper": "Required for the dependency-scoping pipeline (ScopePhpDependencies + the scoper-base config)."
  },

  "minimum-stability": "dev",
  "prefer-stable": true,

  "autoload": {
    "classmap": [
      "php/composer"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WordPressConfigs\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/fixtures/"
    ]
  },

  "scripts": {
    "generate-autoloader": "@composer dump-autoload --ignore-platform-req=php+ -o",
    "packages-install": "@composer install --ignore-platform-req=php+ --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-req=php+ --no-interaction"
    ],

    "format:php": "phpcbf --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "format:php:tests": "phpcbf --standard=./phpcs.tests.dist.xml --basepath=. ./tests -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpcs:tests",
      "@lint:php:phpstan"
    ],
    "lint:php:phpcs": "phpcs --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "lint:php:phpcs:tests": "phpcs --standard=./phpcs.tests.dist.xml --basepath=. ./tests -v",
    "lint:php:phpstan": "phpstan analyse -v --memory-limit=1G",

    "test": [
      "@test:unit"
    ],
    "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
    "test:unit:mutation": "@php vendor/bin/infection --threads=max --show-mutations=0",
    "test:all": [
      "@test:unit",
      "@test:unit:mutation"
    ],

    "quality-check": [
      "@lint:php",
      "@test"
    ],
    "quality-check:all": [
      "@lint:php",
      "@test:all"
    ]
  },

  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
