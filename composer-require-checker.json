{
    "scan-files": [
        "php/php-scoper/*.inc.php"
    ],
    "symbol-whitelist": [
        "Composer\\InstalledVersions",
        "Composer\\Script\\Event",
        "Symfony\\Component\\Filesystem\\Filesystem",
        "Symfony\\Component\\Finder\\Finder"
    ],
    "php-core-extensions": [
        "Core",
        "json",
        "pcre",
        "SPL",
        "standard"
    ]
}
