# Repo self-lint: lints this repo only, extending the shared php/quality-assurance/phpstan.dist.neon profile.
includes:
    - php/quality-assurance/phpstan.dist.neon

parameters:
    # The scoping pipeline and its tests do not pass level 10 or the override check.
    level: 8
    checkMissingOverrideMethodAttribute: false
    paths:
        - php
        - tests
    excludePaths:
        # Test fixtures carry deliberate errors and minimal stubs for the tests that analyse them.
        - tests/fixtures/*
