# Repo self-lint: lints this repo only, extending the shared php/quality-assurance/phpstan.dist.neon baseline.
includes:
    - php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - php
        - tests
    excludePaths:
        # Test fixtures are intentionally minimal stub files (no return types) for testing the stubs collector.
        - tests/fixtures/*
