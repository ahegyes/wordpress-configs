includes:
    - php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - php
        - tests
    excludePaths:
        # Test fixtures are intentionally minimal stub files (no return types) for testing the stubs collector.
        - tests/fixtures/*
        # Shipped stub catalogs are parse-only symbol data mirroring upstream signatures, never executed.
        - php/stubs/*
