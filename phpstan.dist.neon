# Repo self-lint: lints this repo only, extending the shared php/quality-assurance/phpstan.dist.neon profile.
includes:
    - php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - php
        - tests
    excludePaths:
        # Test fixtures carry deliberate errors and minimal stubs for the tests that analyze them.
        - tests/fixtures/*
