{
	"$schema": "https://json.schemastore.org/tsconfig",
	// Assumes TypeScript 6+, whose defaults already provide strict mode, module "esnext",
	// moduleResolution "bundler", esModuleInterop, and a latest-ES target/lib that floats
	// with the compiler. Only deltas from those defaults live here.
	"compilerOptions": {
		"jsx": "react-jsx",

		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,

		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,

		"noEmit": true
	}
}
